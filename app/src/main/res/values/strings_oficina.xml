    <!-- Hub "Ferramentas de Oficina" na aba OBD2 -->
    <string name="oficina_descricao">Testes guiados e engenharia reversa sobre a conexão ativa. Enquanto uma ferramenta estiver aberta, o polling dos sensores fica pausado (sem derrubar o Bluetooth) e volta sozinho ao sair.</string>
    <string name="oficina_requer_conexao">Conecte o scanner para usar o teste de bateria e o terminal.</string>
    <string name="oficina_sem_conexao">Scanner não conectado. Conecte-o na aba Painel e abra a ferramenta de novo.</string>
    <string name="oficina_conexao_perdida">A conexão com o scanner caiu. Volte à aba Painel e reconecte.</string>
    <string name="oficina_copiar">Copiar</string>
    <string name="oficina_compartilhar">Compartilhar</string>
    <string name="oficina_copiado">Copiado para a área de transferência</string>

    <!-- Ferramenta 1: Teste de Bateria e Alternador -->
    <string name="bateria_titulo">Teste de Bateria e Alternador</string>
    <string name="bateria_etapa_n">Etapa %1$d de 3</string>
    <string name="bateria_etapa_concluida">Teste concluído</string>
    <string name="bateria_etapa1_titulo">Bateria em repouso</string>
    <string name="bateria_etapa1_instrucao">Ignição ligada e motor desligado, com faróis, som e ar-condicionado desligados. Toque em Medir: o app aguarda cerca de 3 s até a tensão estabilizar.</string>
    <string name="bateria_etapa2_titulo">Queda na partida (cranking)</string>
    <string name="bateria_etapa2_instrucao">Toque em Iniciar captura e dê a partida normalmente. O app registra a menor tensão até o motor pegar. Se o scanner reiniciar ou perder a comunicação no arranque, a etapa fica inconclusiva (conferir nos polos).</string>
    <string name="bateria_etapa3a_titulo">Alternador em marcha lenta</string>
    <string name="bateria_etapa3a_instrucao">Motor ligado em marcha lenta, sem acelerar. Toque em Medir: 3 s de leitura da tensão de carga.</string>
    <string name="bateria_etapa3b_titulo">Alternador a ~2.000 RPM com cargas</string>
    <string name="bateria_etapa3b_instrucao">Ligue o farol e o ar-condicionado. Toque em Medir e mantenha o motor a ~2.000 RPM por 3 s.</string>
    <string name="bateria_concluido_instrucao">Desligue as cargas e volte o motor à marcha lenta. Confira o veredito abaixo.</string>
