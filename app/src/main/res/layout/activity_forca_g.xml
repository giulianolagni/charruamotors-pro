<?xml version="1.0" encoding="utf-8"?>
<!-- v2.12.0: Medidor de Força G (aba Oficina), com os sensores de movimento do celular. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:colorBackground"
    android:orientation="vertical"
    tools:context=".ui.oficina.forcag.ForcaGActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorPrimary">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            style="@style/Widget.CharruaMotors.Toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:theme="@style/ThemeOverlay.Material3.Dark.ActionBar"
            app:navigationContentDescription="@string/voltar"
            app:navigationIcon="?attr/homeAsUpIndicator"
            app:title="@string/forca_g_titulo" />
    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:id="@+id/conteudo"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/margem_tela">

            <TextView
                android:id="@+id/texto_situacao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textAppearance="?attr/textAppearanceLabelLarge"
                android:textColor="?attr/colorPrimary"
                tools:text="Suporte calibrado" />

            <com.charruamotors.ui.componentes.ForcaGView
                android:id="@+id/mostrador_g"
                android:layout_width="match_parent"
                android:layout_height="320dp"
                android:layout_marginTop="@dimen/espaco_pequeno" />

            <TextView
                android:id="@+id/texto_atual"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"
                android:gravity="center"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                tools:text="Longitudinal 0,12 G · Lateral -0,34 G" />

            <TextView
                android:id="@+id/texto_picos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espaco_pequeno"
                android:fontFeatureSettings="tnum"
                android:gravity="center"
                android:textAppearance="?attr/textAppearanceBodyMedium" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/botao_calibrar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espaco_medio"
                android:text="@string/forca_g_calibrar" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/botao_zerar_picos"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/forca_g_zerar_picos" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switch_gravar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espaco_pequeno"
                android:text="@string/log_forca_g_opcao" />

            <TextView
                android:id="@+id/texto_aviso"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espaco_pequeno"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorPrimary"
                android:visibility="gone" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espaco_pequeno"
                android:text="@string/forca_g_instrucoes"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="@color/texto_secundario" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
