<?xml version="1.0" encoding="utf-8"?>
<!-- Cadastro/edição de um item da manutenção preventiva. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/margem_tela"
        android:paddingTop="@dimen/espaco_pequeno">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layout_nome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/preventiva_campo_nome">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/campo_nome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapSentences"
                android:maxLength="60" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layout_km"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/preventiva_campo_km">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/campo_km"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:maxLength="7" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/preventiva_campo_data">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/campo_data"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layout_intervalo_km"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/preventiva_campo_intervalo_km">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/campo_intervalo_km"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:maxLength="7" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layout_intervalo_meses"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/preventiva_campo_intervalo_meses">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/campo_intervalo_meses"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:maxLength="3" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/preventiva_campo_observacao"
            app:counterEnabled="true"
            app:counterMaxLength="140">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/campo_observacao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLength="140" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/preventiva_sugestao"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="@color/texto_secundario" />
    </LinearLayout>
</ScrollView>
