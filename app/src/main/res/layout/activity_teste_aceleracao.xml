<?xml version="1.0" encoding="utf-8"?>
<!-- v2.6.0: Testes de Aceleração (modalidade, cronômetro, estado e melhores tempos do carro). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:colorBackground"
    android:orientation="vertical"
    tools:context=".ui.desempenho.TesteAceleracaoActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorPrimary">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            style="@style/Widget.CharruaMotors.Toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:theme="@style/ThemeOverlay.Material3.Dark.ActionBar"
            app:navigationContentDescription="@string/voltar"
            app:navigationIcon="?attr/homeAsUpIndicator"
            app:title="@string/aceleracao_titulo" />
    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:id="@+id/conteudo"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/margem_tela">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/grupo_modalidades"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleSelection="true" />

            <TextView
                android:id="@+id/texto_tempo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espaco_medio"
                android:fontFeatureSettings="tnum"
                android:gravity="center"
                android:textSize="64sp"
                android:textStyle="bold"
                tools:text="9,52 s" />

            <TextView
                android:id="@+id/texto_estado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityLiveRegion="polite"
                android:gravity="center"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                tools:text="Armado — acelere quando quiser" />

            <TextView
                android:id="@+id/texto_leituras"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espaco_pequeno"
                android:fontFeatureSettings="tnum"
                android:gravity="center"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                tools:text="62 km/h · 3850 rpm · 74 m" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/botao_teste"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="@dimen/espaco_medio"
                android:text="@string/aceleracao_armar"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/texto_polling"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espaco_pequeno"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="@color/texto_secundario" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espaco_minimo"
                android:text="@string/aceleracao_aviso"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="@color/veredito_atencao" />

            <TextView
                android:id="@+id/texto_historico_titulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espaco_grande"
                android:textAppearance="?attr/textAppearanceTitleMedium" />

            <TextView
                android:id="@+id/texto_historico"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espaco_pequeno"
                android:fontFeatureSettings="tnum"
                android:lineSpacingExtra="4dp"
                android:textAppearance="?attr/textAppearanceBodyMedium" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/botao_apagar"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/aceleracao_apagar" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
