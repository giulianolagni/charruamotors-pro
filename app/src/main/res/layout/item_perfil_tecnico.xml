<?xml version="1.0" encoding="utf-8"?>
<!-- Linha de opção (Perfis Técnicos e PIDs customizados): título e detalhe. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:minHeight="56dp"
    android:orientation="vertical"
    android:paddingTop="@dimen/espaco_pequeno"
    android:paddingBottom="@dimen/espaco_pequeno">

    <TextView
        android:id="@+id/texto_titulo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="?attr/textAppearanceBodyLarge"
        tools:text="Motor 1KD-FTV" />

    <TextView
        android:id="@+id/texto_detalhe"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="@color/texto_secundario"
        tools:text="2005–2015 · Validado" />
</LinearLayout>
