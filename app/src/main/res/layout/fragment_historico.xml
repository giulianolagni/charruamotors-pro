<?xml version="1.0" encoding="utf-8"?>
<!-- Aba Histórico: abastecimentos, sessões gravadas (CSV + TXT) e viagens, num seletor no topo. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/grupo_historico"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/margem_tela"
        android:layout_marginTop="@dimen/espaco_pequeno"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botao_historico_abastecimentos"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingHorizontal="4dp"
            android:text="@string/historico_abastecimentos" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botao_historico_sessoes"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingHorizontal="4dp"
            android:text="@string/historico_sessoes" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botao_historico_viagens"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingHorizontal="4dp"
            android:text="@string/historico_viagens" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Abastecimentos: o Fragment existente, como filho -->
        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/container_abastecimentos"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Sessões gravadas pela caixa-preta e pelo Data Logger: um cartão por sessão -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/painel_sessoes"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/margem_tela">

                <TextView
                    android:id="@+id/titulo_sessoes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/historico_sessoes_titulo"
                    android:textAppearance="?attr/textAppearanceTitleMedium" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/historico_sessoes_dica"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="@color/texto_secundario" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espaco_pequeno"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/botao_abrir_csv"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/espaco_pequeno"
                        android:layout_weight="1"
                        android:text="@string/historico_abrir_csv" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/botao_atualizar"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/historico_atualizar" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/botao_limpar_logs"
                    style="@style/Widget.Material3.Button.TextButton.Icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/historico_limpar_logs"
                    app:icon="@android:drawable/ic_menu_delete" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progresso_sessoes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:indeterminate="true"
                    android:visibility="invisible" />

                <TextView
                    android:id="@+id/texto_sessoes_vazio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="@dimen/espaco_medio"
                    android:text="@string/historico_sessoes_vazio"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="@color/texto_secundario"
                    android:visibility="gone" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/lista_sessoes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:listitem="@layout/item_sessao_log" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- Viagens: a atual (ou a última) e as leituras salvas no Painel -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/painel_viagens"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/margem_tela">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/historico_viagem_atual"
                    android:textAppearance="?attr/textAppearanceTitleMedium" />

                <TextView
                    android:id="@+id/texto_viagem_atual"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espaco_minimo"
                    android:fontFeatureSettings="tnum"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    tools:text="Veículo: Toyota SW4&#10;12,40 km · 18 min · média 41 km/h · 9,8 km/L" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/botao_viagem_detalhes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espaco_pequeno"
                    android:text="@string/historico_viagem_detalhes" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espaco_grande"
                    android:text="@string/historico_viagens_anteriores"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="@color/texto_secundario" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/botao_ver_sessoes"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/historico_ver_sessoes" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espaco_grande"
                    android:text="@string/obd_historico_titulo"
                    android:textAppearance="?attr/textAppearanceTitleMedium" />

                <TextView
                    android:id="@+id/texto_leituras_vazio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="@dimen/espaco_pequeno"
                    android:text="@string/obd_historico_vazio"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="@color/texto_secundario" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/lista_leituras"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:itemCount="3"
                    tools:listitem="@layout/item_leitura_historico" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </FrameLayout>
</LinearLayout>
