<?xml version="1.0" encoding="utf-8"?>
<!-- Diálogo de nova versão: versão/tamanho fixos e as notas da release numa área rolável. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="@dimen/espaco_pequeno">

    <TextView
        android:id="@+id/texto_detalhe"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        tools:text="Você está na v2.11.0. A v2.11.1 já está publicada · APK de 4,7 MB" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/espaco_medio"
        android:text="@string/atualizacao_novidades"
        android:textAppearance="?attr/textAppearanceTitleSmall" />

    <!-- O peso deixa a área encolher e rolar quando o diálogo não cabe; os botões ficam sempre visíveis. -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/espaco_minimo"
        android:layout_weight="1"
        android:scrollbarStyle="outsideInset"
        android:fadeScrollbars="false">

        <TextView
            android:id="@+id/texto_notas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/texto_secundario"
            android:textIsSelectable="true"
            tools:text="• Gráfico de bateria com linhas de referência" />
    </ScrollView>
</LinearLayout>
