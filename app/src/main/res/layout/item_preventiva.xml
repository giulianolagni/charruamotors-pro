<?xml version="1.0" encoding="utf-8"?>
<!-- Um item da manutenção preventiva: situação, última troca e o registro rápido. Toque edita. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:orientation="vertical"
    android:paddingVertical="@dimen/espaco_pequeno">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/texto_nome"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAppearance="?attr/textAppearanceTitleSmall"
            tools:text="Óleo do motor" />

        <TextView
            android:id="@+id/texto_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/espaco_pequeno"
            android:background="@drawable/fundo_pilula_status"
            android:paddingHorizontal="10dp"
            android:paddingVertical="2dp"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:textColor="@android:color/white"
            tools:text="Próximo" />
    </LinearLayout>

    <TextView
        android:id="@+id/texto_detalhe"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="@color/texto_secundario"
        tools:text="faltam 800 km · vence em 20 dias&#10;Última troca: 175.000 km em 02/10/2026" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/botao_registrar"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/preventiva_registrar" />
</LinearLayout>
